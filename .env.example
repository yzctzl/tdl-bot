# 从 @BotFather 获取 Bot token。
BOT_TOKEN=
# 默认直接复用 ./.tdl 的已有登录，无需 API 凭据或再次登录。
SESSION_SOURCE=tdl
TDL_DIR=.tdl
# 仅 SESSION_SOURCE=telethon（独立登录模式）需要以下 API 凭据。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 首次初始化的操作账号 ID，逗号分隔；之后通过 Bot 管理数据库成员。
ALLOWED_USER_IDS=
# 初始管理员；留空时为名单中的第一个账号。初始化后修改此处不覆盖角色。
ADMIN_USER_IDS=
DATA_DIR=data
# 可选账号绑定，默认读取 DATA_DIR/accounts.toml；无绑定时用共享执行账号。
# ACCOUNTS_FILE=data/accounts.toml
TDL_BINARY=bin/tdl
TDL_NAMESPACE=default
# 可选：与 Telethon 同步使用的 socks5／socks4／http 代理。
TDL_PROXY=
WORKERS=2
QUEUE_SIZE=20
DOWNLOAD_TIMEOUT=7200
# tdl upload threads per file; Telethon fallback part window (1-32).
UPLOAD_CONCURRENCY=8
# Maximum duration of one native folder upload, in seconds.
UPLOAD_TIMEOUT=7200
