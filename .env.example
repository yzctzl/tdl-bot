# Obtain the Bot token from @BotFather.
BOT_TOKEN=
# Run uv run tdl-bot login; authorization stays in the project-local TDL_DIR.
SESSION_SOURCE=tdl
TDL_DIR=.tdl
# API credentials are needed only for SESSION_SOURCE=telethon.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Required for first start; manage members and roles through the Bot afterward.
ADMIN_USER_IDS=
DATA_DIR=data
# Other logged-in namespaces in TDL_DIR are discovered by UID on reload.
TDL_BINARY=bin/tdl
TDL_NAMESPACE=default
# Optional socks5, socks4, or http proxy shared by tdl and Telethon.
TDL_PROXY=
WORKERS=2
QUEUE_SIZE=20
DOWNLOAD_TIMEOUT=7200
# tdl clone transfer threads per file; Telethon fallback part window (1-32).
UPLOAD_CONCURRENCY=9
# Maximum duration of one native clone (download and upload), in seconds.
UPLOAD_TIMEOUT=7200
