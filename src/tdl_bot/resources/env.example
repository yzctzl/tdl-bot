# Docker timezone (IANA name). Host setup fills this automatically.
# Native runs continue to use the system timezone.
TZ=

# Paths are relative to this file, not the current working directory.
# Keep this workspace outside any uv tool environment.
DATA_DIR=./data
# Managed executables are separated by OS/architecture under BIN_DIR.
BIN_DIR=./bin
# Existing installations can keep TDL_DIR=.tdl here.
TDL_DIR=./data/tdl
# Optional full executable path; overrides BIN_DIR.
# TDL_BINARY=/path/to/tdl
# Leave unset for native runs. Compose uses a container-local runtime directory.
# RUNTIME_DIR=/run/tdl-bot

# Obtain a Bot token from @BotFather.
BOT_TOKEN=
# Required for the first start; manage members through /user afterward.
ADMIN_USER_IDS=

# Run tdl-bot login with this same .env before starting the Bot.
SESSION_SOURCE=tdl
TDL_NAMESPACE=default
# API credentials are only needed for SESSION_SOURCE=telethon.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional socks5, socks4, or http proxy, reachable from the runtime environment.
TDL_PROXY=
# Concurrent foreground jobs and, separately, background backup cycles.
# Native clone remains serialized per account; this is not a transfer thread count.
WORKERS=2
QUEUE_SIZE=20
DOWNLOAD_TIMEOUT=7200
UPLOAD_CONCURRENCY=8
# Maximum duration of one native clone, including download and upload.
UPLOAD_TIMEOUT=7200
